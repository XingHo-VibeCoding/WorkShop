# 敏感配置：数据库连接串/密钥等，绝不提交（Day 23）
# .env.* 覆盖 .env.local / .env.production 等变体；!.env.example 放行示例文件（它只有键名、没有值，本就该进仓库）
.env
.env.*
!.env.example

# 本地私密文件：不随仓库上传
灵感速记.md
打卡须知.md
打卡区/

# 工作区工具数据（本地记忆、技能等）
.workbuddy/

# 备份与本地缓存（本地工作产物，不进仓库）
source/backups/
.cache/
.slidep/
resource/screenshots/
resource/shots/
resource/before_demo/

# 静态托管上传目录（Day 26）：固定名 workshop，每次由 prepare-release.js 重建，
# 内容随目标版本切换，属于临时产物 → 不进仓库（发布包 v1.0 / rollback-day22 才进仓库留痕）
resource/release/workshop/

# resource 整理后的历史散文件（Day 10-11 诊断/截图/笔记输出，只本地留）
resource/logs/
resource/data/
resource/text/

# WorkBuddy 会话产物（.genie 会话文件），不进仓库
.wbapp_*.genie

# Day 28 增补：发布包与历史日志不进仓库
#   zip 体积大且可从发布流程重建；日志每次重跑内容都变，不适合版本跟踪
resource/release/*.zip
resource/*.log
