# WorkShop · 环境变量示例（Day 23 安全审计新增）
#
# 用法：复制本文件为 .env，再把真实值填进去 —— cp .env.example .env
#
# 红线三条：
#   1. .env 已被 .gitignore 忽略，永远不进仓库、不进提交；
#   2. 本文件只登记"有哪些键"，值一律留空，任何人克隆仓库都能照着配；
#   3. 真实密钥只写在 .env 里、只经 process.env 读取，代码里不出现任何密钥字面量。
#
# 读取位置见各自代码：source/cloud/items/db.js（数据接口）、source/server.js（本地端口）

# —— CloudBase 数据接口 ——
# 环境 ID（CloudBase 控制台可见，不是密钥）
CB_ENV_ID=
# 数据库 schema，不填则默认 public
CB_SCHEMA=
# ★ 服务端 API Key（service_role，绕过 RLS）—— 这是本项目唯一的真密钥，务必只填在 .env 里
CB_API_KEY=

# —— 本地静态服务端口（不填默认 3000）——
PORT=

# —— 腾讯文档导出（A8 预留，P10 骨架）——
# 服务端持此 Token 调腾讯文档 MCP 端点建文档；前端绝不持有。
# 当前未配置 → POST /api/export/doc 返回 503「未配置腾讯文档凭据，请联系管理员」；
# 配了则占位 501「腾讯文档导出暂未开通（MCP 未接入）」（MCP 端点未接入）。
TENCENT_DOC_TOKEN=

# —— 身份令牌签名密钥（阶段二 P6，★ 真密钥）——
# 云函数用它给登录令牌做 HMAC 签名；不配则登录签不出令牌。
# ⚠️ 新增云函数（profile_phase2 / export_phase2）必须从 items 原样复制同一个值，
#    否则会出现「登录了却保存报 401」（2026-10-17 实际事故）。
WORKSHOP_AUTH_SECRET=

# ————————————————
# 验收脚本凭据（只在本地跑 verify-*.js 时用，不参与线上运行）
# 建议写在 .env.verify 里（同样被 .gitignore 的 .env.* 忽略），跑脚本前：
#   set -a; . ./.env.verify; set +a
# ————————————————
# 管理员账号（verify-admin / verify-tenancy / verify-sync / verify-project 都要）
WORKSHOP_ADMIN_NAME=
WORKSHOP_ADMIN_PASS=
# 一名普通成员（验「member 越权 → 403」）
WORKSHOP_TEST_MEMBER=
WORKSHOP_TEST_PASS=
# 一名只读成员（验「readonly 全写拒 → 403」）
WORKSHOP_RO_MEMBER=
WORKSHOP_RO_PASS=
